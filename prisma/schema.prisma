generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DONOR
  NGO
  VOLUNTEER
}

enum VehicleType {
  BICYCLE
  MOTORCYCLE
  CAR
  VAN
  OTHER
}

enum DeliveryMode {
  NGO_SELF_PICKUP
  VOLUNTEER_DELIVERY
}

enum RescueAssignmentStatus {
  OFFERED
  ACCEPTED
  EN_ROUTE_TO_PICKUP
  ARRIVED_AT_PICKUP
  PICKED_UP
  EN_ROUTE_TO_NGO
  ARRIVED_AT_NGO
  DELIVERED
  REJECTED
  EXPIRED
  CANCELLED
  FAILED
}

enum RescueEventType {
  OFFER_CREATED
  OFFER_ACCEPTED
  OFFER_REJECTED
  OFFER_EXPIRED
  STATUS_CHANGED
  LOCATION_RECEIVED
  GEOFENCE_ENTERED
  OTP_VERIFIED
  DELIVERY_CONFIRMED
  SYSTEM_NOTE
}

enum DonationStatus {
  REPORTED
  MATCHING
  NOTIFIED
  ACCEPTED
  PICKUP_IN_PROGRESS
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum MatchState {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationType {
  DONATION_CREATED
  NGO_MATCHED
  STATUS_CONFIRMED
  SYSTEM
}

enum LiveEventType {
  STATUS_CHANGED
  NOTIFICATION_CREATED
  MATCH_UPDATED
  LOCATION_UPDATED
}

model User {
  id                String                    @id @default(cuid())
  name              String
  email             String                    @unique
  passwordHash      String
  role              Role
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  ngoProfile        NgoProfile?
  volunteerProfile  VolunteerProfile?
  donorDonations    Donation[]                @relation("DonorDonations")
  assignedDonations Donation[]                @relation("AssignedDonations")
  statusEvents      DonationStatusEvent[]
  notifications     Notification[]
  liveEvents        LiveEvent[]
  ngoCandidates     NgoMatchCandidate[]       @relation("NgoCandidates")
  rescueAssignments RescueAssignment[]        @relation("VolunteerAssignments")
  rescueEvents      RescueEvent[]             @relation("RescueEventActor")
  locationSamples   VolunteerLocationSample[] @relation("VolunteerLocationSamples")
}

model NgoProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  orgName         String
  phone           String
  address         String
  lat             Float
  lng             Float
  serviceRadiusKm Float    @default(15)
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
}

model VolunteerProfile {
  id              String      @id @default(cuid())
  userId          String      @unique
  phone           String
  vehicleType     VehicleType
  capacityKg      Float
  serviceRadiusKm Float       @default(10)
  isAvailable     Boolean     @default(false)
  currentLat      Float?
  currentLng      Float?
  lastLocationAt  DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isAvailable])
  @@index([lastLocationAt])
}

model Donation {
  id                String         @id @default(cuid())
  donorId           String
  assignedNgoId     String?
  foodType          String
  quantity          String
  servesCount       Int
  estimatedWeightKg Float?
  address           String
  lat               Float
  lng               Float
  pickupBy          DateTime
  notes             String?
  status            DonationStatus @default(REPORTED)
  deliveryMode      DeliveryMode   @default(NGO_SELF_PICKUP)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  donor             User                  @relation("DonorDonations", fields: [donorId], references: [id], onDelete: Cascade)
  assignedNgo       User?                 @relation("AssignedDonations", fields: [assignedNgoId], references: [id])
  statusEvents      DonationStatusEvent[]
  candidates        NgoMatchCandidate[]
  notifications     Notification[]
  rescueAssignments RescueAssignment[]

  @@index([donorId])
  @@index([assignedNgoId])
  @@index([status])
}

model RescueAssignment {
  id                      String                 @id @default(cuid())
  donationId              String
  volunteerId             String
  attemptNumber           Int
  status                  RescueAssignmentStatus @default(OFFERED)
  distanceKm              Float
  offerExpiresAt          DateTime
  pickupLat               Float
  pickupLng               Float
  ngoLat                  Float
  ngoLng                  Float
  respondedAt             DateTime?
  acceptedAt              DateTime?
  completedAt             DateTime?
  pickupOtpHash           String?
  pickupOtpExpiresAt      DateTime?
  pickupOtpAttempts       Int                    @default(0)
  pickupOtpGeneratedAt    DateTime?
  pickupOtpVerifiedAt     DateTime?
  lastLat                 Float?
  lastLng                 Float?
  lastAccuracy            Float?
  lastLocationAt          DateTime?
  lastLocationClientAt    DateTime?
  pickupGeofenceEnteredAt DateTime?
  ngoGeofenceEnteredAt    DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  donation        Donation                  @relation(fields: [donationId], references: [id], onDelete: Cascade)
  volunteer       User                      @relation("VolunteerAssignments", fields: [volunteerId], references: [id], onDelete: Cascade)
  events          RescueEvent[]
  locationSamples VolunteerLocationSample[]

  @@unique([donationId, attemptNumber])
  @@index([volunteerId, status])
  @@index([donationId, status])
  @@index([status, offerExpiresAt])
}

model VolunteerLocationSample {
  id              BigInt   @id @default(autoincrement())
  assignmentId    String
  volunteerId     String
  lat             Float
  lng             Float
  accuracy        Float
  speed           Float?
  heading         Float?
  clientTimestamp DateTime
  createdAt       DateTime @default(now())

  assignment RescueAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  volunteer  User             @relation("VolunteerLocationSamples", fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([assignmentId, createdAt])
  @@index([volunteerId, createdAt])
}

model RescueEvent {
  id           String                  @id @default(cuid())
  assignmentId String
  actorUserId  String?
  sequence     Int
  type         RescueEventType
  fromStatus   RescueAssignmentStatus?
  toStatus     RescueAssignmentStatus?
  note         String?
  metadata     Json?
  createdAt    DateTime                @default(now())

  assignment RescueAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actor      User?            @relation("RescueEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, sequence])
  @@index([assignmentId, createdAt])
  @@index([actorUserId])
}

model DonationStatusEvent {
  id          String         @id @default(cuid())
  donationId  String
  status      DonationStatus
  actorUserId String
  note        String?
  lat         Float?
  lng         Float?
  createdAt   DateTime       @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([donationId, createdAt])
}

model NgoMatchCandidate {
  id         String     @id @default(cuid())
  donationId String
  ngoUserId  String
  distanceKm Float
  rank       Int
  state      MatchState @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngoUser  User     @relation("NgoCandidates", fields: [ngoUserId], references: [id], onDelete: Cascade)

  @@unique([donationId, ngoUserId])
  @@index([ngoUserId, state])
  @@index([donationId, state])
}

model Notification {
  id         String              @id @default(cuid())
  userId     String
  donationId String?
  type       NotificationType
  channel    NotificationChannel
  title      String
  body       String
  metadata   Json?
  readAt     DateTime?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([donationId])
}

model LiveEvent {
  id                  BigInt        @id @default(autoincrement())
  userId              String
  eventType           LiveEventType
  payloadJson         Json
  ablyPublishedAt     DateTime?
  ablyPublishAttempts Int           @default(0)
  ablyNextAttemptAt   DateTime      @default(now())
  ablyLastError       String?
  createdAt           DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([ablyPublishedAt, ablyNextAttemptAt, id])
}

model ContactInquiry {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  topic        String
  message      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
}
